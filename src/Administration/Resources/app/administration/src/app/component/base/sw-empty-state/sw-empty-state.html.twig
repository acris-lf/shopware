{% block sw_empty_state %}
<div
    v-if="useMeteorComponent"
    class="sw-empty-state"
    :class="classes"
>
    <mt-empty-state
        :icon="moduleIcon"
        :headline="title"
        :description="showDescription !== false ? moduleDescription : null"
        :link-href="url"
        :link-text="linkText"
    >
        <template
            v-if="hasButtonSlot"
            #button
        >
            <slot name="button"></slot>
        </template>
    </mt-empty-state>
</div>
{% endblock %}

{# Deprecated component #}
{% block sw_empty_state_deprecated %}
<sw-empty-state-deprecated
    v-else
    :icon="moduleIcon"
    :title="title"
    :subline="subline"
    :class="classes"
    :color="color"
    :absolute="absolute"
>
    <template #icon>
        <slot name="icon"></slot>
    </template>
    <template #default>
        <slot></slot>
    </template>
    <template #actions>
        <slot name="actions"></slot>
    </template>
</sw-empty-state-deprecated>
{% endblock %}
